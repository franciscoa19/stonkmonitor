<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stonkmonitor.backend</string>

    <!-- WorkingDirectory matters: config.py reads .env relative to cwd. -->
    <key>WorkingDirectory</key>
    <string>/Users/francisco/code/stonkmonitor/backend</string>

    <!-- caffeinate -i holds an idle-sleep assertion for as long as the backend
         runs. Without it this Mac (pmset sleep=1) idle-sleeps after a minute,
         on battery AND on AC: on 2026-10-05 it was asleep for 208 of the 390
         market-hours minutes, and nothing runs while it sleeps — no scans, no
         entries, no condor exits, no expiry-day forced close. It does NOT
         override a closed lid: keep the lid open (or use an external display)
         and stay on AC power. The display may still sleep. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/Users/francisco/code/stonkmonitor/backend/venv/bin/uvicorn</string>
        <string>main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <!-- Restart whether it crashed or exited cleanly: an earnings condor left
         unmanaged through its post-print exit is the failure this prevents. -->
    <key>KeepAlive</key>
    <true/>
    <!-- Don't hot-loop if it dies on startup (bad .env, port taken, etc.). -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/francisco/code/stonkmonitor/backend/logs/backend.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/francisco/code/stonkmonitor/backend/logs/backend.log</string>
</dict>
</plist>
