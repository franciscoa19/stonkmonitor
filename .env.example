# ============================================================
#  STONK MONITOR — Environment Variables
#  Copy this to .env and fill in your real keys
# ============================================================

# --- Unusual Whales ---
UNUSUAL_WHALES_API_KEY=your_uw_api_key_here

# --- Alpaca (Paper Trading) ---
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true   # set to false for live trading
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- SEC-API.io (Insider Trades) ---
SEC_API_KEY=your_sec_api_key_here

# --- Discord ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook

# --- Pushover ---
PUSHOVER_API_TOKEN=your_pushover_app_token
PUSHOVER_USER_KEY=your_pushover_user_key

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Earnings IV/RV iron condors ---
# Disabled by default. Only all-gate SELL_PREMIUM setups may execute; CONSIDER
# remains an alert/research result unless explicitly enabled.
IV_EXEC_ENABLED=false
IV_EXEC_ALLOW_CONSIDER=false
IV_EXEC_ENTRY_DAYS_BEFORE=2
IV_EXEC_RISK_PCT=0.015
IV_EXEC_MAX_RISK_USD=1500

# --- IV/RV measurement-only universe ---
# These rows are hypothetical only: they never create alerts or orders. Keep the
# logger on to measure gated vs. ungated outcomes and quote coverage.
IV_VARIANTS_LOG_ENABLED=true
IV_LOG_UNGATED_BASELINE=true
IV_MEASURE_UNIVERSE_ENABLED=true
IV_MEASURE_MIN_MARKET_CAP=10000000000
IV_MEASURE_MAX_PER_CYCLE=25
IV_MEASURE_INTERVAL_HOURS=6

# --- Flow/pattern auto-trading ---
# Paused by default: the prior triple-confluence sample was 0/5. Enable only
# after deliberately re-validating that separate strategy.
AUTO_TRADE_FLOW_ENABLED=false

# --- Signal Engine Thresholds (tune these!) ---
MIN_PREMIUM_ALERT=50000       # minimum $ premium for options flow alert
MIN_DARKPOOL_SIZE=100000      # minimum $ for dark pool print alert
IV_RANK_THRESHOLD=80          # alert when IV rank > this (0-100)
IV_RANK_LOW_THRESHOLD=20      # alert when IV rank < this (buying cheap options)
SWEEP_SCORE_THRESHOLD=7       # 1-10 score to trigger notification
